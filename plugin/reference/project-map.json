      "template": "trd.md",
      "area": "architecture",
      "legacy": [
        "docs/architecture/overview.md"
      ]
    },
    {
      "id": "backend-schema",
      "title": "Backend Schema",
      "path": "docs/backend/schema.md",
      "template": "backend-schema.md",
      "area": "data-model",
      "legacy": [
        "docs/database/design.md"
      ]
    },
    {
      "id": "implementation-plan",
      "title": "Implementation Plan",
      "path": "docs/plan/implementation-plan.md",
      "template": "implementation-plan.md",
      "area": "implementation-plan",
      "legacy": []
    }
  ]
